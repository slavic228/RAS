# ─────────────────────────────────────────────────────────────────────────────
# report-runner — Environment Variables
#
# Copy this file to .env and fill in all values before running.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database connections ──────────────────────────────────────────────────────
# Key format: DB_{ALIAS_UPPER}_{PARAM}
# The alias matches the `database_alias` field in your YAML workflow file.
# Alias is uppercased and hyphens are replaced with underscores.

# Oracle (prefix: oracle_*)
DB_ORACLE_PROD_DSN=host:1521/service_name
DB_ORACLE_PROD_USER=my_oracle_user
DB_ORACLE_PROD_PASSWORD=my_oracle_password

# MSSQL (prefix: mssql_*)
# Full ODBC connection string.
DB_MSSQL_DWH_CONNECTION_STRING=DRIVER={ODBC Driver 17 for SQL Server};SERVER=server_name;DATABASE=db_name;UID=user;PWD=password

# PostgreSQL (prefix: postgres_*)
DB_POSTGRES_ANALYTICS_HOST=localhost
DB_POSTGRES_ANALYTICS_PORT=5432
DB_POSTGRES_ANALYTICS_NAME=my_database
DB_POSTGRES_ANALYTICS_USER=my_pg_user
DB_POSTGRES_ANALYTICS_PASSWORD=my_pg_password

# ── API credentials ───────────────────────────────────────────────────────────
# Referenced in YAML as: ${API_KEY_FX}
# The variable name must match exactly (case-sensitive).
API_KEY_FX=your_fx_api_key_here

# ── SMTP (email sending) ──────────────────────────────────────────────────────
# Key format: SMTP_{ALIAS_UPPER}_{PARAM}
# The alias matches the `smtp_alias` field in your YAML notification blocks.

SMTP_CORP_HOST=smtp.company.com
SMTP_CORP_PORT=587
SMTP_CORP_USER=noreply@company.com
SMTP_CORP_PASSWORD=your_smtp_password
# Set to "false" to disable STARTTLS (not recommended for production).
SMTP_CORP_USE_TLS=true

# ── Logging ───────────────────────────────────────────────────────────────────
# Directory where rotating log files will be written.
# On Windows: C:/reports/logs
# On Linux/macOS: /var/log/report-runner  or  ./logs
LOG_DIR=logs

# Minimum log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Loguru rotation trigger: "10 MB" | "1 day" | "500 KB"
LOG_ROTATION=10 MB

# How long to keep old log files: "30 days" | "1 week"
LOG_RETENTION=30 days
